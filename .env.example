# Crux environment template.
# Copy to `.env` (gitignored) and fill in real values.
# Used by both native dev (backend/config.py reads this via _REPO_ROOT) and
# docker compose prod stack (docker-compose.prod.yml --env-file .env).

# --- Runtime ---
# Deploy environment. "prod" refuses to boot against a sqlite DATABASE_URL.
# ENV=dev
# Max bytes accepted for a non-multipart (JSON) request body, rejected before
# parsing (C-03).
# MAX_JSON_BODY_BYTES=65536
# Seconds the /ready DB probe may take before the endpoint reports 503 (G-07).
# READINESS_TIMEOUT_S=2.0
# The web process drains the ingestion queue itself. Set false only when a
# dedicated worker service (python -m worker) runs alongside.
# INGEST_IN_PROCESS=true

# --- LLM provider (Google AI Studio via LiteLLM) ---
GEMINI_API_KEY=your-google-ai-studio-key-here
MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-2
# Sampling temperature for tutor turns.
# LLM_TEMPERATURE=0.3
# Sampling temperature for session summaries (0 = deterministic).
# SUMMARY_TEMPERATURE=0.0
# Per-call LiteLLM timeouts in seconds (F-06). Chat streams get the longest
# budget; summaries and embeddings are shorter single-shot calls.
# LLM_TIMEOUT_S=30.0
# SUMMARY_TIMEOUT_S=20.0
# EMBEDDING_TIMEOUT_S=15.0
# Bounded retry for transient provider failures on embedding calls only.
# attempts = extra tries after the first; 0 disables.
# LLM_RETRY_ATTEMPTS=2
# LLM_RETRY_BASE_DELAY_S=0.5

# --- Storage (Supabase-managed Postgres + pgvector — Phase 7) ---
# DATABASE_URL: from Supabase → Project Settings → Database → Connection
# string → URI (pooler, transaction mode, port 6543). The app prepends
# `postgresql+psycopg://` if you paste a bare `postgresql://` URL.
# See docs/db/postgres-pgvector-setup.md.
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Seconds a request waits for a pooled DB connection before failing (F-01).
# DB_POOL_TIMEOUT_S=5.0
# SQLAlchemy pool sizing; must respect the Render instance and Supabase
# pooler client limits (B-10).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Seconds psycopg waits for the TCP connect before failing (G-07 follow-up).
# DB_CONNECT_TIMEOUT_S=5.0
UPLOADS_PATH=./data/uploads
# Uploaded-blob storage: "local" (default, dev) or "r2" (prod)
UPLOADS_STORE=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Vector dim for chunk_embeddings. Default 768 matches gemini-embedding-2 (see EMBEDDING_MODEL).
# Change requires re-running migration 0002 + re-embedding all chunks.
EMBEDDING_DIM=768
# Retrieval tuning.
# Cosine-similarity floor below which a retrieved chunk is not surfaced as a
# citation; None-scored chunks pass (G-11).
# CITATION_MIN_SIMILARITY=0.25
# SET LOCAL hnsw.ef_search for the retrieval transaction; pgvector default 40 (F-10).
# HNSW_EF_SEARCH=100
# Similarity below which retrieval falls back to the wider search path.
# RETRIEVAL_FALLBACK_THRESHOLD=0.75

# --- Supabase Auth (Phase 7) ---
# See docs/auth/supabase-setup.md. Backend verifies JWTs against JWKS.
# Uses the 2025+ key-naming model: `publishable` (frontend) + `secret` (backend).
# Legacy `anon` + `service_role` keys are NOT used.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<...backend only, never ship to client>
# Publishable key is public by design; docker compose bakes it (plus
# SUPABASE_URL) into the frontend bundle as VITE_* vars at build time.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...safe for the client bundle>
# Refuse to boot without SUPABASE_URL unless explicitly opted out (F-61).
# (Guard actually keys on the derived JWKS URL being empty, which happens
# only when SUPABASE_URL is empty AND SUPABASE_JWKS_URL_OVERRIDE is also unset.)
# Set true only for local hacking without auth.
AUTH_OPTIONAL=false
# Point JWKS at a non-Supabase issuer (tests, self-hosted GoTrue). Empty =
# derive it from SUPABASE_URL.
# SUPABASE_JWKS_URL_OVERRIDE=

# --- LLM cost cap (Phase 7) ---
# Local default; the Render blueprint pins lower values, see docs/reference.md.
LLM_SOFT_CAP_USD=2.00
LLM_HARD_CAP_USD=3.00
# Optional service-wide daily spend ceiling in USD. Unset = disabled.
# GLOBAL_DAILY_COST_CAP_USD=10.00
# Max chunks a single document may produce (default 5000).
# MAX_CHUNKS=5000
# Max pages (PDF) or slides (PPTX) a single upload may contain (default 400).
# MAX_PAGES=400
# Provisional USD charge reserved at the cost gate for a turn, released when
# the turn ends (B-05).
# LLM_TURN_RESERVE_USD=0.02

# --- Rate limit ---
# Max chat requests per user per UTC day. Set DAILY_CAP=2 to demo the cap UI.
DAILY_CAP=50
# Per-user rolling 60 s burst limit on paid endpoints. 0 disables. Independent
# of DAILY_CAP (B-07).
# BURST_LIMIT_PER_MINUTE=0

# --- CORS ---
# Comma-separated list of allowed origins. Add your ngrok URL here when tunneling.
# Example: CORS_ORIGINS=http://localhost:5173,https://abc-123.ngrok-free.app
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Dev only ---
# LLM_STUB=1 short-circuits the agent loop with a canned response (CI / offline).
LLM_STUB=0
# Log per-stage timings for a chat turn.
# DEBUG_TIMING=false
# Hard cap per topic-profile concept list (confirmed_gaps, mastered_concepts);
# oldest entries evicted at write time (F-35).
# MAX_PROFILE_LIST=40

# --- Logging (G-05) ---
# Root logger level. One of DEBUG/INFO/WARNING/ERROR/CRITICAL.
# LOG_LEVEL=INFO
